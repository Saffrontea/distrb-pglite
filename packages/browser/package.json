{
  "name": "@distrb-pglite/browser",
  "version": "0.0.0",
  "private": true,
  "description": "Browser adapters for distrb-pglite: DistributedBrowserPGlite facade, OPFS filesystem, browser CAS snapshot/restore, and browser WebSocket transport.",
  "keywords": [
    "browser",
    "cas",
    "edge-database",
    "eventual-consistency",
    "local-first",
    "opfs",
    "pglite",
    "postgres",
    "replication",
    "snapshot",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Saffrontea/distrb-pglite",
    "directory": "packages/browser"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=30000"
  },
  "dependencies": {
    "@distrb-pglite/core": "workspace:*",
    "@electric-sql/pglite": "^0.5.1"
  }
}
